# ======================================================
# Agent Commerce — MCP reverse proxy local (Fase 4)
#
# Uso:
#   1. Instalar Caddy manualmente (não incluído no repo).
#   2. Garantir que mcp.localhost resolve para 127.0.0.1
#      (ficheiro hosts do Windows).
#   3. Confiar na CA local uma vez: `caddy trust`.
#   4. npm run mcp:http            (Terminal 1)
#   5. caddy run --config infra/caddy/Caddyfile   (Terminal 2)
#   6. MCP_PUBLIC_BASE_URL=https://mcp.localhost npm run dev
#
# O proxy NÃO faz OAuth: só TLS + encaminhamento.
# Sem HSTS agressivo e sem CORS aberto nesta fase.
# ======================================================

mcp.localhost {
	tls internal

	reverse_proxy 127.0.0.1:3002

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}
